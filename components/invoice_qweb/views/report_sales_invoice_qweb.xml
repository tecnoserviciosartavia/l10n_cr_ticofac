    <template id="cr_custom_external_header_boxed">
        <html lang="es">
            <head>
                <meta charset="utf-8"/>
                <meta http-equiv="Content-Type" content="text/html; charset=utf-8"/>
                <meta name="viewport" content="width=device-width, initial-scale=1"/>
                <link href="https://fonts.googleapis.com/css?family=Droid+Sans" rel="stylesheet" type="text/css"/>
                <style>html, body { margin: 0; padding: 0; }</style>
            </head>
            <body>
                <t t-set="safe_company" t-value="(company and company._name == 'res.company' and company) or env.company"/>
                <div class="header">
                    <table width="100%" style="border-collapse: collapse; margin-bottom: 6px;">
                        <tr>
                            <td style="width: 20%; text-align: left; vertical-align: middle;">
                                <img t-if="safe_company and safe_company.logo" t-att-src="image_data_uri(safe_company.logo)" style="max-width: 132px; max-height: 105px; margin-top: 0px;"/>
                            </td>
                            <td style="width: 60%; text-align: center; vertical-align: middle;">
                                <div style="font-size: 18px; font-weight: 800; margin-bottom: 4px;">
                                    <t t-esc="safe_company.name"/>
                                </div>
                                <div style="font-size: 12px; font-weight: 700; margin-bottom: 3px;">
                                    <t t-if="safe_company and safe_company.street"><t t-esc="safe_company.street"/> , </t>
                                    <t t-if="safe_company and safe_company.city"><t t-esc="safe_company.city"/></t>
                                    <t t-if="safe_company and safe_company.state_id"> - <t t-esc="safe_company.state_id.name"/></t>
                                    <t t-if="safe_company and safe_company.zip"> / <t t-esc="safe_company.zip"/></t>
                                    <t t-if="safe_company and safe_company.country_id"> , <t t-esc="safe_company.country_id.name"/></t>
                                </div>
                                <div style="font-size: 11px; font-weight: 700;">
                                    <t t-esc="(safe_company and safe_company.email) or ''"/>
                                </div>
                            </td>
                            <td style="width: 20%;"></td>
                        </tr>
                    </table>
                </div>

                <style>
                    .header {
                        position: fixed;
                        top: -18mm;
                        left: 0;
                        right: 0;
                        height: 18mm;
                        padding-top: 2mm;
                    }
                    .footer {
                        position: fixed;
                        bottom: -18mm;
                        left: 0;
                        right: 0;
                        height: 18mm;
                        padding-bottom: 2mm;
                    }
                    main[role="main"] {
                        display: block;
                        margin-top: 1mm;
                        margin-bottom: 18mm;
                    }
                    .address, .company_address, .o_company_address {
                        display: none !important;
                    }
                    div[name="company_address"] {
                        display: none !important;
                    }
                    @page {
                        margin-top: 18mm;
                        margin-bottom: 18mm;
                        margin-left: 12mm;
                        margin-right: 12mm;
                    }
                    .page {
                        padding-top: 0 !important;
                        margin-top: 0 !important;
                        background: #fff;
                    }
                    body {
                        font-family: 'Droid Sans', Arial, sans-serif;
                        font-size: 13px;
                        color: #222;
                    }
                    .cp-table {
                        width: 100%;
                        margin: 4px 0;
                        font-size: 11px;
                        line-height: 1.4;
                        border-collapse: collapse;
                        border: none !important;
                    }
                    .cp-table td {
                        vertical-align: top;
                        border: none !important;
                        padding: 0;
                    }
                    .cp-left {
                        width: 58%;
                        padding-right: 16px;
                        word-break: break-word;
                        font-size: 11px;
                    }
                    .cp-right {
                        width: 42%;
                        text-align: right;
                        font-size: 11px;
                    }
                    .cp-table div {
                        margin-bottom: 4px;
                    }
                    .rounded2 { border: 1px solid #ddd; padding: 6px 6px; border-radius: 3px; }
                </style>

                <main role="main">
                    <t t-out="0"/>
                </main>

                <div class="footer">
                    <div style="border-top: 1px solid #000; padding: 8px 20px; font-size: 11px;">
                        <div style="text-align: center; font-weight: bold; margin-bottom: 6px;">
                            Para Transferencias:
                        </div>
                        <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                            <div t-if="safe_company and safe_company.html_bank_account1" style="flex: 1; text-align: left; padding-right: 10px;">
                                <span t-field="safe_company.html_bank_account1"/>
                            </div>
                            <div t-if="safe_company and safe_company.html_bank_account2" style="flex: 1; text-align: right; padding-left: 10px;">
                                <span t-field="safe_company.html_bank_account2"/>
                            </div>
                        </div>
                    </div>

                    <t t-set="doc" t-value="(docs and docs[0]) or doc or o or None"/>
                    <t t-if="doc and doc._name == 'account.move' and ('is_electronic_document' in doc._fields and doc.is_electronic_document)">
                        <div style="border-top: 1px solid #000; padding: 8px 20px; font-size: 10px; margin-bottom: 6px;">
                            <div class="rounded2" style="margin-bottom: 4px;">
                                <p style="font-size: 9px; padding: 2px; text-align: justify; margin: 0;">
                                    Este documento constituye factura comercial con titulo ejecutivo de acuerdo al art. 460 del Código de Comercio
                                    que podrá hacerse efectivo el día de su vencimiento y en caso de ejecución, renuncio a mi domicilio y los
                                    trámites de juicio ejecutivo. Esta factura devengará 3% mensual después de su vencimiento.
                                </p>
                            </div>
                            <p class="text-center" style="font-size: 9px; padding: 2px; margin: 0;">
                                Autorizada mediante resolución MH-DGT-RES-0027-2024 del 13 de Noviembre del 2024 de la Dirección General de Tributación
                            </p>
                        </div>
                    </t>
                </div>
            </body>
        </html>
    </template>

    <template id="report_invoice_document_fecr">
        <t t-set="o" t-value="(docs and docs[0]) or doc or o"/>
        <t t-set="company" t-value="company or (o and o.company_id) or env.company"/>
        <t t-out="'\ufeff'"/>
        <t t-call="l10n_cr_ticofac.cr_custom_external_header_boxed">
            <style>
                body { font-family: 'Droid Sans', Arial, sans-serif; font-size: 14px; }
                @page { margin-top: 3mm; margin-bottom: 13mm; }
                .page { padding-top: 0 !important; margin-top: 0 !important; }
            </style>

            <div class="page" style="padding: 0 20px;">
                <t t-set="doc_type" t-value="(o.move_type in ('out_refund', 'in_refund') and 'NOTA DE CREDITO ELECTRONICA') or (o.tipo_documento == 'TE' and 'TIQUETE ELECTRONICO') or (o.tipo_documento == 'FEE' and 'FACTURA ELECTRONICA DE EXPORTACION') or (o.tipo_documento == 'ND' and 'NOTA DEBITO ELECTRONICA') or 'FACTURA ELECTRONICA'"/>
                <t t-set="doc_number" t-value="(o and (('number_electronic' in o._fields and o.number_electronic) or ('invoice_number' in o._fields and o.invoice_number) or ('l10n_latam_document_number' in o._fields and o.l10n_latam_document_number) or ('number' in o._fields and o.number) or ('name' in o._fields and o.name))) or ''"/>

                <table class="cp-table" style="margin-top: 0;">
                    <tr>
                        <td class="cp-left">
                            <div><strong>Cliente:</strong> <span t-field="o.partner_id.name"/></div>
                            <div><strong>Cédula:</strong> <span t-field="o.partner_id.vat"/></div>
                            <div><strong>Tel:</strong> <span t-field="o.partner_id.phone"/></div>
                            <div><strong>C. Facturación:</strong>
                                <t t-if="o.partner_id.email">
                                    <t t-set="_emails" t-value="o.partner_id.email.split(',')"/>
                                    <t t-foreach="_emails" t-as="_em">
                                        <span t-esc="_em"/>
                                        <br t-if="_em != _emails[-1]"/>
                                    </t>
                                </t>
                            </div>
                            <div><strong>Dirección:</strong>
                                <t t-esc="o.partner_id.street or ''"/>
                                <t t-if="o.partner_id.street2">, <t t-esc="o.partner_id.street2"/></t>
                                <t t-if="o.partner_id.city">, <t t-esc="o.partner_id.city"/></t>
                                <t t-if="o.partner_id.state_id">, <t t-esc="o.partner_id.state_id.name"/></t>
                                <t t-if="o.partner_id.country_id">, <t t-esc="o.partner_id.country_id.name"/></t>
                            </div>
                        </td>
                        <td class="cp-right">
                            <div style="font-size: 20px; font-weight: 800; margin-bottom: 4px;"><strong><span t-esc="doc_type"/></strong></div>
                            <div><strong>N°:</strong> <span t-field="o.name"/></div>
                            <div><strong>N° Documento:</strong> <span t-esc="doc_number or ''"/></div>
                            <div><strong>Condición de pago:</strong> <span t-esc="o.invoice_payment_term_id and o.invoice_payment_term_id.name or ''"/></div>
                            <div t-if="o.customer_purchase_order"><strong>Orden de compra:</strong> <span t-field="o.customer_purchase_order"/></div>
                            <div><strong>Fecha emisión:</strong> <span t-field="o.invoice_date" t-options="{'widget': 'date'}"/></div>
                        </td>
                    </tr>
                </table>

                <table class="table table-sm" width="100%" style="border-collapse: collapse; margin-top: 10px; font-size: 11px;">
                    <thead style="background: #f0f0f0;">
                        <tr>
                            <th style="border: 1px solid #000; padding: 5px;">Descripción</th>
                            <th style="border: 1px solid #000; text-align: center; padding: 5px;">Cantidad</th>
                            <th style="border: 1px solid #000; text-align: right; padding: 5px;">Precio Unit ₡</th>
                            <th style="border: 1px solid #000; text-align: right; padding: 5px;">Sub Total ₡</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="o.invoice_line_ids" t-as="l">
                            <tr>
                                <td style="padding: 5px;">
                                    <t t-set="description_lines" t-value="(l.name or '').split('\n')"/>
                                    <t t-if="len(description_lines) &gt; 1">
                                        <t t-foreach="description_lines[1:]" t-as="desc_line">
                                            <span t-esc="desc_line"/><br t-if="not desc_line_last"/>
                                        </t>
                                    </t>
                                    <t t-else="">
                                        <span t-field="l.name"/>
                                    </t>
                                </td>
                                <td style="text-align: center; padding: 5px;">
                                    <span t-field="l.quantity"/>
                                </td>
                                <td style="text-align: right; padding: 5px;">
                                    <span t-field="l.price_unit" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                                </td>
                                <td style="text-align: right; padding: 5px;">
                                    <span t-field="l.price_subtotal" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                                </td>
                            </tr>
                        </t>
                    </tbody>
                </table>

                <div style="margin-top: 10px; text-align: right;">
                    <div style="display: inline-block; min-width: 300px;">
                        <div style="display: flex; justify-content: space-between; padding: 3px 0;">
                            <span>Sub Total:</span>
                            <span t-field="o.amount_untaxed" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                        </div>
                        <div style="display: flex; justify-content: space-between; padding: 3px 0;">
                            <span>Descuento:</span>
                            <span>0.00</span>
                        </div>
                        <div style="display: flex; justify-content: space-between; padding: 3px 0;">
                            <span>IVA:</span>
                            <span t-field="o.amount_tax" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                        </div>
                        <div style="display: flex; justify-content: space-between; padding: 3px 0; font-weight: bold;">
                            <span>Total:</span>
                            <span t-field="o.amount_total" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                        </div>
                    </div>
                </div>

                <div style="margin-top: 15px; font-size: 12px;">
                    <div style="margin-bottom: 5px;">
                        <strong>Total:</strong>
                        <span t-esc="o.currency_id and o.currency_id.amount_to_text(o.amount_total) or ''"/>
                    </div>
                    <div>
                        <strong>Tipo Cambio:</strong>
                        <span t-esc="o.amount_total_signed and round(abs(o.amount_total / o.amount_total_signed), 5) or 0.0"/>
                    </div>
                </div>

                <div style="margin-top: 20px; margin-bottom: 80px;">
                    <span t-field="o.narration"/>
                </div>

                <t t-if="('number_electronic' in o._fields and o.number_electronic) and o.qr_image">
                    <div style="text-align: right; margin-top: 8px; page-break-inside: avoid;">
                        <div style="font-size: 10px; margin-bottom: 4px;">Clave electrónica</div>
                        <img t-att-src="image_data_uri(o.qr_image)"
                             alt="QR de la clave electrónica"
                             style="width: 140px; height: 140px;"/>
                    </div>
                </t>

                <div style="position: relative; height: 220px; margin-top: 20px; page-break-inside: avoid;">
                    <div style="position: absolute; bottom: 0; left: 0; width: 60%;">
                        <table style="width:100%; font-size:12px;">
                            <tr>
                                <td style="width:33%; text-align:center;">_____________________<br/>Nombre</td>
                                <td style="width:33%; text-align:center;">_____________________<br/>No.Cédula</td>
                                <td style="width:33%; text-align:center;">_____________________<br/>Firma</td>
                            </tr>
                        </table>
                    </div>
                </div>
            </div>
        </t>
    </template>

<template id="account.report_invoice">
    <t t-call="web.html_container">
        <t t-foreach="docs" t-as="o">
            <t t-set="lang" t-value="o.partner_id.lang"/>
            <t t-if="o._get_name_invoice_report() == 'account.report_invoice_document'" t-call="account.report_invoice_document" t-lang="lang"/>
            <t t-if="o._get_name_invoice_report() == 'l10n_cr_ticofac.report_invoice_document_fecr'" t-call="l10n_cr_ticofac.report_invoice_document_fecr" t-lang="lang"/>
        </t>
    </t>
</template>

<template id="account.report_invoice_with_payments">
    <t t-call="web.html_container">
        <t t-foreach="docs" t-as="o">
            <t t-set="lang" t-value="o.partner_id.lang"/>
            <t t-set="print_with_payments" t-value="True"/>
            <t t-if="o._get_name_invoice_report() == 'account.report_invoice_document'" t-call="account.report_invoice_document" t-lang="lang"/>
            <t t-if="o._get_name_invoice_report() == 'l10n_cr_ticofac.report_invoice_document_fecr'" t-call="l10n_cr_ticofac.report_invoice_document_fecr" t-lang="lang"/>
        </t>
    </t>
</template>

</odoo>
