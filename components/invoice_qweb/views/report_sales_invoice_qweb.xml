                }
                .dtheader{
                    background-color:#ce0b9d;
                    color:#ffffff;
                    border:none;
                    padding:5px 5px;
                }
                .dtcls{
                color:#ce0b9d;
                width:25%;
                padding:5px 5px;
                border: 1px solid;
                }
                .dtbg{
                    margin:5px 5px;
                    background-color:#fff;
                }
            </style>
            <style  t-if="o.company_id.cr_invoice_color == 'moresempai'" type="text/css">

                    body {
                        font-family: 'Droid Sans', Arial, sans-serif;
                        font-size:16px;

                    }

                .title{
                color:#661ab2;
                font-size:24px;
                font-weight:bolder;
                }
                .rounded2{
                border: 1px solid;
                padding:5px 5px;
                }
                .dtheader{
                    background-color:#661ab2;
                    color:#ffffff;
                    border:none;
                    padding:5px 5px;
                }
                .dtcls{
                color:#661ab2;
                width:25%;
                padding:5px 5px;
                border: 1px solid;
                }
                .dtbg{
                    margin:5px 5px;
                    background-color:#fff;
                }
            </style>
            <style  t-if="o.company_id.cr_invoice_color == 'blue'" type="text/css">

                    body {
                        font-family: 'Droid Sans', Arial, sans-serif;
                        font-size:16px;

                    }

                .title{
                color:#2874A6;
                font-size:24px;
                font-weight:bolder;
                }
                .rounded2{
                border: 1px solid;
                padding:5px 5px;
                }
                .dtheader{
                    background-color:#2874A6;
                    color:#ffffff;
                    border:none;
                    padding:5px 5px;
                }
                .dtcls{
                color:#2874A6;
                width:25%;
                padding:5px 5px;
                border: 1px solid;
                }
                .dtbg{
                    margin:5px 5px;
                    background-color:#fff;
                }
            </style>
            <style  t-if="o.company_id.cr_invoice_color == 'green'" type="text/css">

                    body {
                        font-family: 'Droid Sans', Arial, sans-serif;
                        font-size:16px;

                    }

                .title{
                color:#196F3D;
                font-size:24px;
                font-weight:bolder;
                }
                .rounded2{
                border: 1px solid;
                padding:5px 5px;
                }
                .dtheader{
                    background-color:#196F3D;
                    color:#ffffff;
                    border:none;
                    padding:5px 5px;
                }
                .dtcls{
                color:#196F3D;
                width:25%;
                padding:5px 5px;
                border: 1px solid;
                }
                .dtbg{
                    margin:5px 5px;
                    background-color:#fff;
                }
            </style>
        </div>

        <div t-attf-class="article o_report_layout_standard o_company_#{company.id}_layout {{  'o_layout_background' if company.layout_background in ['Geometric', 'Custom']  else  '' }}" t-attf-style="background-image: url({{ 'data:image/png;base64,%s' % company.layout_background_image.decode('utf-8') if company.layout_background_image and company.layout_background == 'Custom' else '/base/static/img/bg_background_template.jpg' if company.layout_background == 'Geometric' else ''}});" t-att-data-oe-model="o and o._name" t-att-data-oe-id="o and o.id" t-att-data-oe-lang="o and o.env.context.get('lang')">
            <div class="pt-5">
                <!-- This div ensures that the address is not cropped by the header. -->
                <t t-call="web.address_layout"/>
            </div>
            <t t-out="0"/>
        </div>

        <div t-attf-class="footer o_standard_footer o_company_#{company.id}_layout">
            <!--div t-if="company.report_footer" class="text-center" style="border-top: 1px solid black;">
                <ul class="list-inline mb4">
                    <div t-field="company.report_footer"/>
                </ul>
            </div-->
        </div>
