<?xml version="1.0" encoding="utf-8"?>
<odoo>
<data>
    <record id="paperformat_ticofac_invoice_letter" model="report.paperformat">
        <field name="name">TicoFac Factura - Carta</field>
        <field name="default" eval="False"/>
        <field name="format">Letter</field>
        <field name="page_height">0</field>
        <field name="page_width">0</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">45</field>
        <field name="margin_bottom">25</field>
        <field name="margin_left">10</field>
        <field name="margin_right">10</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">40</field>
        <field name="dpi">90</field>
        <field name="css_margins" eval="True"/>
    </record>

    <record id="account.account_invoices" model="ir.actions.report">
        <field name="paperformat_id" ref="l10n_cr_ticofac.paperformat_ticofac_invoice_letter"/>
    </record>

    <record id="account.account_invoices_without_payment" model="ir.actions.report">
        <field name="paperformat_id" ref="l10n_cr_ticofac.paperformat_ticofac_invoice_letter"/>
    </record>
</data>
</odoo>
