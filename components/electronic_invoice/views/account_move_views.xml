<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_inherit" model="ir.ui.view">
        <field name="name">account.move.form.inherit</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">

            <xpath expr="//sheet" position="before">
                <div class="alert alert-info mb-0" role="alert"
                     invisible="(state_tributacion not in (False)) or (state in ('draft', 'cancel'))">
                    El documento todavía no ha sido emitido. Se enviará automáticamente en 5 minutos. Para enviarlo
                    manualmente, presione
                    <button class="btn btn-link" type="object" name="generate_and_send_invoice"
                            style="padding: 0; vertical-align: baseline;">Enviar documento</button>
                </div>
                <div class="alert alert-warning mb-0" role="alert"
                    invisible="state_tributacion not in ('procesando') or state  in ('draft', 'cancel')">
                    El documento fue emitido correctamente, pero todavía no se ha recibido la respuesta. Se consultará
                    en 10 minutos. Para consultarlo manualmente, presione
                    <button class="btn btn-link" type="object" name="action_check_hacienda_for_invoices"
                            style="padding: 0; vertical-align: baseline;">Consultar documento</button>
                </div>
            </xpath>

            <xpath expr="//button[@name='button_draft']" position="after">
                <button name="action_send_mrs_to_hacienda" type="object" string="Enviar mensaje receptor"
                        invisible="(move_type not in ('in_invoice', 'in_refund', 'entry')) or (tipo_documento == 'FEC')"/>
                <button name="action_create_fec" type="object" string="Enviar FEC"
                        invisible="tipo_documento != 'FEC' or state_tributacion not in (False,'rechazado','error')"/>
                <button name="create_partner_from_xml" class="btn btn-primary" type="object" string="Crear proveedor"
                        invisible="move_type in ('entry', 'out_invoice', 'out_refund') or partner_id != False or xml_supplier_approval == False"/>
            </xpath>

            <xpath expr="//field[@name='narration']/.." position="inside">
                <br/>
                <field name="invoice_amount_text" class="oe_inline" nolabel="1"/>
            </xpath>

            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="number_electronic" readonly="1"
                       invisible="move_type not in ('out_invoice','out_refund','in_invoice','in_refund')"/>
                <field name="sequence" readonly="1"
                       invisible="move_type not in ('out_invoice','out_refund','in_invoice','in_refund')"/>
            </xpath>

            <xpath expr="//field[@name='ref']" position="before">
                <!-- Campo invisible para obtener las actividades del proveedor -->
                <field name="partner_economic_activities_ids" invisible="1" readonly="1"/>
                
                <!-- Campo visible para actividades económicas del proveedor -->
                <field name="partner_economic_activity_id"
                       string="Actividad Económica Proveedor"
                       readonly="state != 'draft'"       
                       invisible="move_type not in ('in_invoice', 'in_refund') and tipo_documento != 'FEC'"
                       domain="[('id', 'in', partner_economic_activities_ids)]"
                       options='{"no_open": True, "no_create": True}'/>

                <field name="partner_economic_activity_id"
                       string="Actividad Económica Cliente"
                       readonly="state != 'draft'"
                       required="move_type in ('out_invoice', 'out_refund') and tipo_documento in ('FE', 'NC', 'ND')"
                       invisible="move_type not in ('out_invoice', 'out_refund')"
                       domain="[('id', 'in', partner_economic_activities_ids)]"
                       options='{"no_open": True, "no_create": True}'/>

                <!-- Campo invisible para obtener las actividades propias -->
                <field name="economic_activities_ids" invisible="1" readonly="1"/>
                
                <!-- Campo visible para actividades económicas propias -->
                <field name="economic_activity_id"
                       string="Actividad Económica Empresa"
                       readonly="state != 'draft'"       
                       required="move_type in ('out_invoice', 'out_refund') or tipo_documento == 'FEC'"
                       domain="[('id', 'in', economic_activities_ids)]"
                       options='{"no_open": True, "no_create": True}'/>

                <field name="reference_document_id" 
                        invisible="tipo_documento != 'FEC'" 
                        readonly="state != 'draft'"
                        domain="[('code', 'in', [14, 16, 99])]"/>
            </xpath>

            <xpath expr="//field[@name='ref']" position="after">
                <field name="customer_purchase_order"
                       placeholder="Ej.: OC-4500123456"
                       invisible="move_type not in ('out_invoice', 'out_refund')"
                       readonly="state != 'draft'"/>
            </xpath>

            <xpath expr="//field[@name='invoice_date']" position="attributes">
                <attribute name="readonly"></attribute>
            </xpath>

            <xpath expr="//field[@name='invoice_date']" position="after">
                <field name="date_issuance" string="Fecha de emisión" readonly="1"
                       invisible="(move_type not in ('out_invoice', 'out_refund','in_invoice', 'in_refund'))"/>
                <field name="tipo_documento" string="Tipo de comprobante"
                       readonly="(state != 'draft')"
                       invisible="move_type not in ('out_invoice','out_refund','in_invoice','in_refund')"
                       required="move_type in ('out_invoice','out_refund','in_invoice', 'in_refund')"/>
                <field name="payment_methods_id" string="Medio de pago"
                       readonly="(state != 'draft')"
                       invisible="move_type not in ('out_invoice', 'out_refund','in_invoice', 'in_refund')"/>
            </xpath>

            <xpath expr="//field[@name='invoice_line_ids']//list//field[@name='name']" position="after">
                <field name="categ_name" invisible="1" readonly="1"/>
                <field name="product_code" invisible="1" readonly="1"/>
                <field name="third_party_id" invisible="product_code != '04'" optional="hide"/>
                <field name="cabys_code" readonly="1" optional="hide"/>
            </xpath>
            
            <xpath expr="//field[@name='invoice_line_ids']//list//field[@name='discount']" position="after">
                <field name="discount_code_id" optional="hide" required="discount > 0"/>
                <field name="discount_note" optional="hide"/>
                <field name="tariff_head" optional="hide"/>
            </xpath>

            <xpath expr="//button[@name='action_invoice_sent']" position="attributes">
                <attribute name="invisible">False</attribute>
            </xpath>

            <xpath expr="(//field[@name='tax_totals'])" position="before">
                <field name="amount_discount_electronic_invoice"
                    invisible="move_type not in ('out_invoice','out_refund') or amount_discount_electronic_invoice == 0"
                    readonly="state != 'draft' or (move_type not in ('in_invoice', 'in_refund', 'in_receipt') and not quick_edit_mode)"/>
            </xpath>
            <xpath expr="(//field[@name='tax_totals'])" position="after">
                <field name="amount_iva_returned" 
                    invisible="move_type not in ('out_invoice','out_refund') or amount_iva_returned == 0"
                    readonly="state != 'draft' or (move_type not in ('in_invoice', 'in_refund', 'in_receipt') and not quick_edit_mode)"/>
            </xpath>

            <xpath expr="(//field[@name='tax_totals'])" position="after">
                <field name="amount_tax_electronic_invoice"
                       invisible="move_type in ('out_invoice','out_refund')"/>
                <field name="amount_total_electronic_invoice"
                       invisible="(move_type in ('out_invoice', 'out_refund'))"/>
            </xpath>

            <xpath expr="//page[2]" position="after">
                <page name="fe_invoice_data" string="Información electrónica"
                      invisible="move_type not in ('out_invoice','out_refund','in_invoice','in_refund')">
                    <field name="qr_image" widget="image" invisible="1"/>
                    <group id="fe_tab_group" col="2">
                        <group string="Aceptación electrónica" name="fe_in_info_group" colspan="2" col="4"
                            invisible="tipo_documento == 'FEC' or move_type in ('out_invoice','out_refund')">

                            <field name="fname_xml_supplier_approval" invisible="1"/>
                            <field name="xml_supplier_approval" filename="fname_xml_supplier_approval" colspan="3"
                                invisible="tipo_documento == 'FEC' or move_type in ('out_invoice','out_refund')"/>
                            <button name="load_xml_data" type="object" string="Cargar datos del XML" colspan="1"
                                    invisible="xml_supplier_approval == False or move_type in ('out_invoice','out_refund') or tipo_documento == 'FEC' or state != 'draft'"/>
                            <newline/>                            
                            <field name="state_invoice_partner" 
                                invisible="move_type in ('out_invoice','out_refund') or tipo_documento == 'FEC'"/>
                        </group>
                        <group name="eref_info_group" colspan="2">
                            <group string="Referencia del documento electrónico" name="eref_info_group1" colspan="2">
                                <field name="reference_code_id" string="Código de referencia" readonly="(state != 'draft')"/>
                                <field name="reference_document_id" string="Tipo de documento de referencia" readonly="(state != 'draft')"/>
                                <field name="invoice_id" string="Factura original" domain="[('number_electronic', '!=', False)]"
                                       readonly="(state != 'draft')"/>
                                <field name="not_loaded_invoice" string="Número de factura original no cargada"
                                       readonly="state != 'draft'"
                                       invisible="invoice_id  != False"/>
                                <field name="not_loaded_invoice_date" string="Fecha de factura original no cargada"
                                       readonly="(state != 'draft')"
                                       invisible="(invoice_id != False)"/>
                            </group>
                            <group string="Comprobantes electrónicos" name="eref_info_group2" colspan="2">
                                <field name="fname_xml_comprobante" invisible="1" readonly="1"/>
                                <field name="xml_comprobante" string="Comprobante XML" filename="fname_xml_comprobante"/>
                                <field name="fname_xml_respuesta_tributacion" invisible="1" readonly="1"/>
                                <field name="xml_respuesta_tributacion" string="Respuesta XML de Hacienda" filename="fname_xml_respuesta_tributacion"/>
                                <field name="state_tributacion" string="Estado de factura electrónica" readonly="1"
                                       widget="badge" class="o_ticofac_hacienda_status"
                                       decoration-success="state_tributacion == 'aceptado'"
                                       decoration-warning="state_tributacion in ('procesando', False)"
                                       decoration-danger="state_tributacion in ('rechazado', 'error', 'firma_invalida')"
                                       decoration-info="state_tributacion in ('recibido', 'ne')"
                                       decoration-muted="state_tributacion == 'na'"/>
                                <field name="electronic_invoice_return_message" string="Respuesta de Hacienda" readonly="1"/>
                                <field name="hacienda_rejection_summary"
                                       string="Qué debe corregir"
                                       readonly="1"
                                       invisible="state_tributacion != 'rechazado'"/>
                                <field name="hacienda_rejection_reason" invisible="1"/>
                            </group>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_move_list_inherit" model="ir.ui.view">
        <field name="name">account.invoice.list.inherit</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_invoice_tree"/>
        <field name="arch" type="xml">
            <xpath expr='//list' position="attributes">
                <attribute name="decoration-danger">
                    state_tributacion == 'rechazado'
                </attribute>
            </xpath>            
            <xpath expr="//list//field[@name='name']" position="after">
                <field name="tipo_documento" string="Doc Elect." optional="show"/>
                <field name="state_tributacion" string="Estado FE" optional="show" 
                    widget="badge" class="o_ticofac_hacienda_status"
                    decoration-success="state_tributacion == 'aceptado'"
                    decoration-warning="state_tributacion == 'procesando'"
                    decoration-danger="state_tributacion in ('rechazado', 'error')"
                    decoration-info="state_tributacion == 'pendiente'"/>
            </xpath>            
        </field>
    </record>

    <record id="view_account_invoice_filter" model="ir.ui.view">
        <field name="name">account.invoice.select.inherited</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_invoice_filter"/>
        <field name="arch" type="xml">
            <field name="name" string="Factura"
                   filter_domain="['|', '|', '|' , '|', '|', ('name', 'ilike', self), ('invoice_origin', 'ilike', self), ('ref', 'ilike', self), ('invoice_payment_ref', 'ilike', self), ('partner_id', 'child_of', self), ('reference', 'ilike', self)]"/>
        </field>
    </record>
</odoo>