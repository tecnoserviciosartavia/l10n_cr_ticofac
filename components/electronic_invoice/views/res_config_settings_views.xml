<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="electronic_invoice_res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="l10n_cr_ticofac.hacienda_res_config_settings_view_form"/>
        <field name="arch" type="xml">

            <xpath expr="//block[@name='fecr_setting_container']" position="inside">
                <setting>
                    <field name="expense_product_id"
                           string="Default product for expenses when importing electronic invoice"/>
                </setting>
                <setting>
                    <field name="expense_account_id"
                           string="Default account for expenses when importing electronic invoice"
                           required="0"/>
                </setting>
                <setting>
                    <field name="expense_analytic_account_id"
                           string="Default analytic account for expenses when importing electronic invoice"/>
                </setting>
                <setting>
                     <field name="load_lines"/>
                </setting>
            </xpath>
            
            <xpath expr="//block[@name='fecr_setting_container']" position="inside">
                <!-- Nueva configuración de medio de pago por defecto -->
                <separator string="💰 Medio de pago Predeterminado" style="margin-top: 20px;"/>
                <setting id="default_payment_method_setting">
                    <div class="o_form_label">
                        <label for="payment_method_default_id"/>
                        <div class="text-muted">
                            Selecciona el medio de pago predeterminado para las facturas electrónicas.
                        </div>
                        <div class="content-group mt16">
                            <div class="mt16">
                                <field name="payment_method_default_id"/>
                            </div>
                        </div>
                    </div>
                </setting>
            </xpath>

        </field>
    </record>
</odoo>
