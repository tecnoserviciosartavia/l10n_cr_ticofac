<odoo>
    <record id="pos_res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='pos_bills_and_receipts_section']" position="inside">
                <setting id="ticofac_pos_receipt_setting"
                         string="Tiquete fiscal TicoFac Costa Rica"
                         help="Diseño fiscal del recibo impreso para comprobantes electrónicos de Costa Rica.">
                    <field name="pos_ticofac_receipt_enabled"/>
                </setting>

                <setting id="ticofac_default_customer_setting"
                         string="Cliente predeterminado"
                         help="Cliente que se asignará inicialmente a las ventas del POS."
                         invisible="not pos_ticofac_receipt_enabled">
                    <field name="pos_default_partner_id" options="{&quot;no_create&quot;: True}"/>
                </setting>

                <setting id="ticofac_show_customer_setting"
                         string="Datos del cliente"
                         help="Muestra nombre, identificación y correo del cliente."
                         invisible="not pos_ticofac_receipt_enabled">
                    <field name="pos_ticofac_receipt_show_customer"/>
                </setting>

                <setting id="ticofac_show_address_setting"
                         string="Dirección del emisor"
                         help="Muestra la dirección registrada de la empresa."
                         invisible="not pos_ticofac_receipt_enabled">
                    <field name="pos_ticofac_receipt_show_address"/>
                </setting>

                <setting id="ticofac_show_activity_setting"
                         string="Actividad económica"
                         help="Muestra el código de actividad económica en el tiquete."
                         invisible="not pos_ticofac_receipt_enabled">
                    <field name="pos_ticofac_receipt_show_activity"/>
                </setting>

                <setting id="ticofac_show_payment_setting"
                         string="Datos de pago"
                         help="Muestra condición de venta, medio de pago y moneda."
                         invisible="not pos_ticofac_receipt_enabled">
                    <field name="pos_ticofac_receipt_show_payment"/>
                </setting>

                <setting id="ticofac_show_qr_setting"
                         string="Código QR fiscal"
                         help="Imprime el QR asociado con la clave electrónica."
                         invisible="not pos_ticofac_receipt_enabled">
                    <field name="pos_ticofac_receipt_show_qr"/>
                </setting>

                <setting id="ticofac_qr_size_setting"
                         string="Tamaño del QR"
                         help="Selecciona el tamaño del código QR impreso."
                         invisible="not pos_ticofac_receipt_enabled or not pos_ticofac_receipt_show_qr">
                    <field name="pos_ticofac_receipt_qr_size"/>
                </setting>

                <setting id="ticofac_qr_label_setting"
                         string="Texto del QR"
                         help="Mensaje que aparece debajo del código QR."
                         invisible="not pos_ticofac_receipt_enabled or not pos_ticofac_receipt_show_qr">
                    <field name="pos_ticofac_receipt_qr_label" placeholder="Escanee para consultar la clave electrónica"/>
                </setting>

                <setting id="ticofac_legal_text_setting"
                         string="Texto legal del cierre"
                         help="Resolución, versión y mensaje final del comprobante."
                         invisible="not pos_ticofac_receipt_enabled">
                    <field name="pos_ticofac_receipt_legal_text" placeholder="Resolución y versión del comprobante"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>