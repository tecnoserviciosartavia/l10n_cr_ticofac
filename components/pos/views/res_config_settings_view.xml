<odoo>
    <record id="pos_res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='pos_bills_and_receipts_section']" position="inside">
                <setting id="ticofac_pos_receipt_setting"
                         string="Tiquete fiscal TicoFac Costa Rica"
                         help="Diseño fiscal del recibo impreso para comprobantes electrónicos de Costa Rica.">
                    <field name="pos_ticofac_receipt_enabled"/>
                    <div class="content-group mt16 w-100" invisible="not pos_ticofac_receipt_enabled">
                        <div class="row g-3 w-100">
                        <div class="col-12 col-lg-6 mt16 d-flex align-items-center">
                            <label for="pos_default_partner_id" string="Cliente predeterminado" class="col-lg-4 o_light_label"/>
                            <field name="pos_default_partner_id" options="{&quot;no_create&quot;: True}"/>
                        </div>
                        <div class="col-12 col-lg-6 mt16 d-flex align-items-center">
                            <label for="pos_ticofac_receipt_show_qr" string="Mostrar QR de la clave" class="col-lg-4 o_light_label"/>
                            <field name="pos_ticofac_receipt_show_qr"/>
                        </div>
                        <div class="col-12 col-lg-6 mt16 d-flex align-items-center">
                            <label for="pos_ticofac_receipt_show_customer" string="Mostrar datos del cliente" class="col-lg-4 o_light_label"/>
                            <field name="pos_ticofac_receipt_show_customer"/>
                        </div>
                        <div class="col-12 col-lg-6 mt16 d-flex align-items-center">
                            <label for="pos_ticofac_receipt_show_address" string="Mostrar dirección del emisor" class="col-lg-4 o_light_label"/>
                            <field name="pos_ticofac_receipt_show_address"/>
                        </div>
                        <div class="col-12 col-lg-6 mt16 d-flex align-items-center">
                            <label for="pos_ticofac_receipt_show_activity" string="Mostrar actividad económica" class="col-lg-4 o_light_label"/>
                            <field name="pos_ticofac_receipt_show_activity"/>
                        </div>
                        <div class="col-12 col-lg-6 mt16 d-flex align-items-center">
                            <label for="pos_ticofac_receipt_show_payment" string="Mostrar datos de pago" class="col-lg-4 o_light_label"/>
                            <field name="pos_ticofac_receipt_show_payment"/>
                        </div>
                        <div class="col-12 col-lg-6 mt16 d-flex align-items-center" invisible="not pos_ticofac_receipt_show_qr">
                            <label for="pos_ticofac_receipt_qr_size" string="Tamaño del QR" class="col-lg-4 o_light_label"/>
                            <field name="pos_ticofac_receipt_qr_size"/>
                        </div>
                        <div class="col-12 col-lg-6 mt16 d-flex align-items-center" invisible="not pos_ticofac_receipt_show_qr">
                            <label for="pos_ticofac_receipt_qr_label" string="Texto bajo el QR" class="col-lg-4 o_light_label"/>
                            <field name="pos_ticofac_receipt_qr_label" placeholder="Escanee para consultar la clave electrónica"/>
                        </div>
                        <div class="col-12 mt16 d-flex align-items-start">
                            <label for="pos_ticofac_receipt_legal_text" string="Texto legal del cierre" class="col-lg-4 o_light_label"/>
                            <field name="pos_ticofac_receipt_legal_text" placeholder="Resolución y versión del comprobante"/>
                        </div>
                        </div>
                        <div class="text-muted mt16">El encabezado y pie libres se editan en las opciones estándar de esta misma sección.</div>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>