<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_res_config_settings_cabys_sac_stock" model="ir.ui.view">
    <field name="name">res.config.settings.cabys.sac.stock.inherit</field>
    <field name="model">res.config.settings</field>
    <field name="inherit_id" ref="stock.res_config_settings_view_form"/>
    <field name="arch" type="xml">
      <xpath expr="//app[@name=&quot;stock&quot;]" position="inside">
        <block title="Ticofac CABYS" name="ticofac_cabys_stock_settings" class="o_ticofac_settings">
          <setting string="Búsqueda por equivalencia SAC" help="Permite buscar y asignar CABYS desde el código SAC de un producto.">
            <field name="enable_cabys_sac_search"/>
          </setting>
        </block>
      </xpath>
    </field>
  </record>
</odoo>
