<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_cabys_sac_equivalence_list" model="ir.ui.view">
            <field name="name">cabys.sac.equivalence.list</field>
            <field name="model">cabys.sac.equivalence</field>
            <field name="arch" type="xml">
                <list string="Equivalencias SAC - CABYS">
                    <field name="sac_code"/>
                    <field name="cabys_code"/>
                    <field name="cabys_product_id"/>
                </list>
            </field>
        </record>

        <record id="view_cabys_sac_equivalence_form" model="ir.ui.view">
            <field name="name">cabys.sac.equivalence.form</field>
            <field name="model">cabys.sac.equivalence</field>
            <field name="arch" type="xml">
                <form string="Equivalencia SAC - CABYS">
                    <sheet>
                        <group>
                            <field name="sac_code"/>
                            <field name="cabys_product_id" options="{'no_create': True, 'no_quick_create': True}"/>
                            <field name="cabys_code" readonly="1"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_cabys_sac_equivalence_search" model="ir.ui.view">
            <field name="name">cabys.sac.equivalence.search</field>
            <field name="model">cabys.sac.equivalence</field>
            <field name="arch" type="xml">
                <search string="Buscar Equivalencias">
                    <field name="sac_code"/>
                    <field name="cabys_code"/>
                    <field name="cabys_product_id"/>
                </search>
            </field>
        </record>

        <record id="action_cabys_sac_equivalence" model="ir.actions.act_window">
            <field name="name">Equivalencias SAC - CABYS</field>
            <field name="res_model">cabys.sac.equivalence</field>
            <field name="view_mode">list,form</field>
        </record>

        <menuitem id="menu_cabys_sac_root" name="Equivalencias SAC - CABYS" parent="l10n_cr_ticofac.menu_cabys" action="action_cabys_sac_equivalence" sequence="50"/>
    </data>
</odoo>
