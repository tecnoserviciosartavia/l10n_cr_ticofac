<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <!-- Add Discount Code button to ProductScreen control buttons dialog -->
    <!-- Hide the button for refund lines (they inherit discount code from original and should not be modified) -->
    <t t-name="l10n_cr_ticofac.ControlButtons" 
       t-inherit="point_of_sale.ControlButtons" 
       t-inherit-mode="extension">
        <xpath expr="//t[@t-if='props.showRemainingButtons']/div/button[hasclass('o_pricelist_button')]"
               position="before">
            <button t-if="pos.company?.invoice_is_electronic and pos.get_order()?.get_selected_orderline()?.discount > 0 and !pos.get_order()?.get_selected_orderline()?.refunded_orderline_id"
                    class="btn btn-secondary btn-lg py-5"
                    t-on-click="() => this.onClickDiscountCode()">
                <i class="fa fa-tag me-1"/>Cód. Descuento
            </button>
        </xpath>
    </t>

    <!-- Show discount code info and warnings in POS order lines -->
    <!-- Extend OrderSummary to add slot content to Orderline where we have access to the actual line model -->
    <t t-name="l10n_cr_ticofac.OrderSummary" 
       t-inherit="point_of_sale.OrderSummary" 
       t-inherit-mode="extension">
        <xpath expr="//Orderline" position="inside">
            <!-- Inside the Orderline slot, 'line' is the actual PosOrderline model from the parent scope -->
            <!-- Don't show warning for refund lines (they inherit discount code from original) -->
            <!-- Using discountCodeId (camelCase) to avoid Odoo's relational proxy detection -->
            <t t-if="line.discount > 0 and !line.discountCodeId and !line.refunded_orderline_id">
                <li class="text-warning fw-bold info discount-code-warning">
                    <i class="fa fa-exclamation-triangle me-1" role="img" aria-label="Warning" title="Missing discount code"/>
                    <span>Falta código de descuento</span>
                </li>
            </t>
            <t t-if="line.discount > 0 and line.discountCodeId">
                <li class="text-info info discount-code-info">
                    <i class="fa fa-tag me-1" role="img" aria-label="Discount Code" title="Discount Code"/>
                    <span>Cód. descuento: </span>
                    <strong t-esc="line.getDiscountCodeDisplay()"/>
                </li>
            </t>
        </xpath>
    </t>

</templates>
