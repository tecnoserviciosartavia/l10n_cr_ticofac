<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="l10n_cr_ticofac.FiscalReceiptHeader"
       t-inherit="point_of_sale.ReceiptHeader"
       t-inherit-mode="extension">
        <xpath expr="//img[hasclass('pos-receipt-logo')]" position="attributes">
            <attribute name="t-if">not props.data.company.uses_default_logo</attribute>
        </xpath>
        <xpath expr="//div[hasclass('pos-receipt-contact')]" position="replace">
            <div t-if="props.data.ticofac_receipt_enabled"
                 class="pos-receipt-contact w-100"
                 style="font-size:12px; line-height:1.35;">
                <div class="text-center">
                    <div t-if="props.data.company.name"
                         class="fw-bolder"
                         style="font-size:18px; line-height:1.15;"
                         t-esc="props.data.company.name"/>
                    <div t-if="props.data.company.vat">
                        <strong>Identificación:</strong>
                        <t t-esc="props.data.company.vat"/>
                    </div>
                    <div t-if="props.data.ticofac_receipt_show_address and (props.data.company.street or props.data.company.city)">
                        <strong>Dirección:</strong> <t t-esc="props.data.company.street or props.data.company.city"/>
                    </div>
                    <div t-if="props.data.company.phone">
                        <strong>Teléfono:</strong> <t t-esc="props.data.company.phone"/>
                    </div>
                    <div t-if="props.data.company.email" t-esc="props.data.company.email"/>
                    <div t-if="props.data.company.website" t-esc="props.data.company.website"/>
                    <div t-if="props.data.header"
                         class="mt-1"
                         style="white-space:pre-line"
                         t-esc="props.data.header"/>
                </div>

                <div t-if="props.data.number_electronic"
                     class="my-2 py-2"
                     style="border-top:1px dashed #000; border-bottom:1px dashed #000;">
                    <div class="text-center fw-bolder" style="font-size:15px;">
                        <t t-if="props.data.tipo_documento === 'FE'">FACTURA ELECTRÓNICA</t>
                        <t t-elif="props.data.tipo_documento === 'NC'">NOTA DE CRÉDITO ELECTRÓNICA</t>
                        <t t-else="">TIQUETE ELECTRÓNICO</t>
                    </div>
                    <div class="d-flex mt-1"><strong>Documento:</strong><span class="ms-auto" style="font-family:monospace;" t-esc="props.data.sequence"/></div>
                    <div class="d-flex"><strong>Fecha:</strong><span class="ms-auto" t-esc="props.data.order_date"/></div>
                    <div t-if="props.data.ticofac_receipt_show_activity and props.data.economic_activity" class="d-flex"><strong>Act. económica:</strong><span class="ms-auto" t-esc="props.data.economic_activity"/></div>
                    <div class="mt-1"><strong>Clave:</strong></div>
                    <div class="text-center" style="font-family:monospace; font-size:10px; overflow-wrap:anywhere; word-break:break-all;" t-esc="props.data.number_electronic"/>
                </div>

                <div t-if="props.data.ticofac_receipt_show_customer and props.data.partner"
                     class="my-2 p-2"
                     style="border-top:1px dashed #000; border-bottom:1px dashed #000;">
                    <div class="fw-bolder">CLIENTE</div>
                    <div><strong>Nombre:</strong> <t t-esc="props.data.partner.name"/></div>
                    <div t-if="props.data.partner.vat">
                        <strong>Identificación:</strong> <t t-esc="props.data.partner.vat"/>
                    </div>
                    <div t-if="props.data.partner.email">
                        <strong>Correo:</strong> <t t-esc="props.data.partner.email"/>
                    </div>
                </div>

                <div class="text-center mt-2">
                    <div t-if="props.data.terminal"><strong>Terminal:</strong> <t t-esc="props.data.terminal"/></div>
                    <div t-if="props.data.is_restaurant and props.data.cashier">
                        <strong>Atendido por:</strong> <t t-esc="props.data.cashier"/>
                    </div>
                    <div t-if="props.data.is_restaurant and props.data.trackingNumber and !props.data.bigTrackingNumber"
                         class="fw-bolder"
                         style="font-size:20px;">
                        Orden # <t t-esc="props.data.trackingNumber"/>
                    </div>
                </div>
            </div>

            <div t-else="" class="pos-receipt-contact">
                <div t-if="props.data.company.name" t-esc="props.data.company.name"/>
                <div t-if="props.data.company.phone">Tel: <t t-esc="props.data.company.phone"/></div>
                <div t-if="props.data.company.vat" t-esc="vatText"/>
                <div t-if="props.data.company.email" t-esc="props.data.company.email"/>
                <div t-if="props.data.company.website" t-esc="props.data.company.website"/>
                <div t-if="props.data.header" style="white-space:pre-line" t-esc="props.data.header"/>
                <div t-if="props.data.cashier" class="cashier">
                    <div>--------------------------------</div>
                    <div t-esc="props.data.cashier"/>
                </div>
            </div>
        </xpath>
    </t>

    <t t-name="l10n_cr_ticofac.FiscalOrderReceipt"
       t-inherit="point_of_sale.OrderReceipt"
       t-inherit-mode="extension">
        <xpath expr="//OrderWidget" position="before">
            <div t-if="props.data.headerData.ticofac_receipt_enabled and props.data.fiscal_show_payment" class="my-2 py-2" style="border-top:1px dashed #000; border-bottom:1px dashed #000; font-size:11px;">
                <div class="d-flex"><strong>Condición de venta:</strong><span class="ms-auto" t-esc="props.data.fiscal_sale_condition"/></div>
                <div class="d-flex" t-if="props.data.paymentlines and props.data.paymentlines.length"><strong>Medio de pago:</strong><span class="ms-auto" t-esc="props.data.paymentlines[0].name"/></div>
                <div class="d-flex"><strong>Moneda:</strong><span class="ms-auto" t-esc="props.data.currency_name"/></div>
            </div>
            <div t-if="props.data.headerData.ticofac_receipt_enabled" class="d-flex fw-bolder py-1" style="border-bottom:1px dashed #000; font-size:11px;">
                <span>Cant. / Producto</span><span class="ms-auto">Total</span>
            </div>
        </xpath>
        <xpath expr="//div[hasclass('after-footer')]" position="before">
            <div t-if="props.data.fiscal_qr_code" class="mt-3 text-center">
                <div style="border-top:1px dashed #000; padding-top:10px;">
                    <img t-att-src="props.data.fiscal_qr_code" alt="QR de la clave electrónica" t-att-style="'width:' + props.data.fiscal_qr_size_cm + ';height:' + props.data.fiscal_qr_size_cm + ';image-rendering:pixelated;'"/>
                    <div t-if="props.data.fiscal_qr_label" style="font-size:9px; line-height:1.1;" t-esc="props.data.fiscal_qr_label"/>
                </div>
            </div>
            <div t-if="props.data.headerData.ticofac_receipt_enabled"
                 class="text-center mt-2"
                 style="font-size:9px; line-height:1.2;">
                <div t-if="props.data.fiscal_legal_text" style="white-space:pre-line;" t-esc="props.data.fiscal_legal_text"/>
            </div>
        </xpath>
        <xpath expr="//div[hasclass('pos-receipt-order-data')][p]" position="replace">
            <div class="pos-receipt-order-data">
                <div t-esc="props.data.name"/>
                <div id="order-date" t-esc="props.data.date"/>
            </div>
        </xpath>
    </t>
</templates>
